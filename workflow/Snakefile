def is_config_true(value):
    """Interpret a boolean cell from the methods config table.

    This column is read with na_values="" and then .fillna("None"), so a blank
    cell arrives here as the string "None" -- which is truthy. Testing truthiness
    directly therefore negates the threshold of any method whose cell was left
    empty, while process_predictions.R (which tests invert %in% c("True","TRUE"))
    does NOT negate that method's scores. The result is a silently desynchronized
    sign for that one method: predictions kept above the threshold are exactly the
    ones that should have been excluded. Comparing explicitly here keeps the two
    in step.
    """
    if isinstance(value, str):
        return value.strip().lower() == "true"
    return bool(value)

def has_threshold(value):
    return not (str(value).strip() in ("", "None", "nan") or pd.isna(value))

# Inverse predictors are compared as -score >= -threshold. A blank threshold
# becomes NaN: the method then appears only in threshold-free outputs.
methods_config['threshold'] = [((-1)*float(thresh) if is_config_true(inverse) else float(thresh)) if has_threshold(thresh) else float("nan")
                                for thresh,inverse in zip(methods_config['threshold'], methods_config['inverse_predictor'])
                                ]

