# Methods with a threshold get the thresholded outputs (thresholded enrichment
# heatmaps, recall heatmaps, distance-stratified comparisons, report tables).
THRESHOLDED_METHODS = [m for m in config["methods"] if has_threshold(methods_config.loc[m, "threshold"])]

# Group methods by candidate element-gene universe, so the candidate-universe
# heatmaps plot each distinct universe once instead of once per method (see
# determine_candidate_universe_groups() in utils.smk).
UNIVERSE_GROUP_LABEL = determine_candidate_universe_groups(methods_config, config)
UNIVERSE_GROUP_MEMBERS = {}
for method, label in UNIVERSE_GROUP_LABEL.items():
    UNIVERSE_GROUP_MEMBERS.setdefault(label, []).append(method)
# Candidate tables are read from one member; use the one covering the most biosamples.
UNIVERSE_GROUP_REPRESENTATIVE = {label: max(sorted(members), key=lambda m: len(methods_config.loc[m, "biosamples"]))
                                 for label, members in UNIVERSE_GROUP_MEMBERS.items()}

# define some variables needed in rules
GTExTissues_all = [] # find set of all GTEx tissues with biosample matches across methods
for x in config["methods"]:
    GTExTissues_all.extend(methods_config.loc[x, "GTExTissue_map"])
GTExTissues_matched = [*set(GTExTissues_all)]
GTExTissues_plus_all = GTExTissues_matched + ["AllMatches"]
# distance bins: for example, min = 0, 10, 100, 0 and max = 10, 100, 250, 30000 kb (30 Mb)
config["distances_min"] = [0] + config["distances"][0:-1] + [0]
config["distances_max"] = config["distances"] + [30000]

# Keeps "count_matrix.0to30000Kb.candidateUniverse.tsv" from also matching the
